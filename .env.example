# The merchant backend's own port. `next dev` takes 3000, so this must not be
# 3000 — and it has to match NEXT_PUBLIC_SERVER_URL below.
PORT=5252
HOST=0.0.0.0
# Comma-separated origins, or * for all
CORS_ORIGIN=*

# Where the browser reaches the merchant backend. Baked into the client bundle
# at build time, so change it before `next build`, not after.
NEXT_PUBLIC_SERVER_URL=http://localhost:5252

# Hyperswitch (https://app.hyperswitch.io/api for snd_ keys)
HYPERSWITCH_BASE_URL=https://app.hyperswitch.io/api
# Secret key — server only, never sent to the browser
HYPERSWITCH_API_KEY=snd_xxx
HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_xxx
HYPERSWITCH_PROFILE_ID=pro_xxx
