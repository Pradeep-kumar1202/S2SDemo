PORT=3000
HOST=0.0.0.0
# Comma-separated origins, or * for all
CORS_ORIGIN=*

# Hyperswitch (https://sandbox.hyperswitch.io for snd_ keys)
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_API_KEY=snd_xxx
HYPERSWITCH_PUBLISHABLE_KEY=pk_snd_xxx
HYPERSWITCH_PROFILE_ID=pro_xxx

# Inject test google_pay/apple_pay session tokens when the profile returns none (demo only)
MOCK_WALLET_SESSION_TOKENS=false
# Apple Pay merchant ID used by the mock apple_pay token (must match ios/S2SDemo/S2SDemo.entitlements)
APPLE_PAY_MERCHANT_ID=merchant.com.s2sdemo
